# Copy this file to .env and fill in the values.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# SQLite for local development; in production use e.g.
# DATABASE_URL=postgres://invigilation:password@localhost:5432/invigilation
DATABASE_URL=sqlite:///db.sqlite3
TIME_ZONE=Asia/Karachi

# Address used for links in emails
SITE_URL=http://127.0.0.1:8000
DEFAULT_FROM_EMAIL=invigilation@localhost
# Development: emails are written to sent_emails/. For real sending use SMTP, e.g.:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.university.edu
# EMAIL_PORT=587
# EMAIL_HOST_USER=invigilation@university.edu
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# Production only: serve over https, then turn this on (secure cookies, redirect, HSTS).
# HTTPS=True
# CSRF_TRUSTED_ORIGINS=https://duties.university.edu

# Production (written by deploy\windows\install.ps1)
# LOG_DIR=C:\InvigilationDuties\logs
# BACKUP_DIR=C:\InvigilationDuties\backups
# BACKUP_KEEP_DAYS=30
# PG_BIN=C:\Program Files\PostgreSQL\17\bin
# WEB_PORT=8000
# WEB_THREADS=8

# WhatsApp Cloud API (official WhatsApp Business Platform). Secrets stay here only.
# WHATSAPP_TOKEN=            System User access token with whatsapp_business_messaging
# WHATSAPP_APP_SECRET=       Meta app secret, used to check webhook signatures
# WHATSAPP_VERIFY_TOKEN=     any long random text; also entered in the Meta webhook settings
