# Copy this file to .env and fill in the values.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# SQLite for local development; in production use e.g.
# DATABASE_URL=postgres://user:password@db:5432/invigilation
DATABASE_URL=sqlite:///db.sqlite3
TIME_ZONE=Asia/Karachi

# Address used for links in emails
SITE_URL=http://127.0.0.1:8000
DEFAULT_FROM_EMAIL=invigilation@localhost
# Development: emails are written to sent_emails/. For real sending use SMTP, e.g.:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.university.edu
# EMAIL_PORT=587
# EMAIL_HOST_USER=invigilation@university.edu
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
